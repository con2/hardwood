{
  "name": "hardwood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3161",
    "build": "prisma contract emit && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:migrate": "prisma db migrate",
    "db:migrate:dev": "prisma db migrate --advance-ref db",
    "db:verify": "prisma db verify",
    "init": "tsx src/bin/init.ts",
    "add-gm": "tsx src/bin/add-gm.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@con2/components": "github:con2/components#v5.2.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "@zxcvbn-ts/language-fi": "4.1.1",
    "bootstrap": "5.3.8",
    "next": "16.4.3",
    "pg": "8.22.0",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-toolchain": "8.0.0-rc.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prisma": "8.0.0-rc.13",
    "sass": "1.106.0",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {}
}
