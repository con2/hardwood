# Copy to .env for local development. All values have safe dev defaults in src/config.ts;
# production refuses to start without DATABASE_URL, SESSION_SECRET and KDF_PEPPER.
DATABASE_URL=postgresql:///hardwood
TEST_DATABASE_URL=postgresql:///hardwood_test

# Encrypts and signs the session cookie. Use a long random string in production.
SESSION_SECRET=insecure-dev-secret

# Secret input to the password KDF. Changing it makes every existing password useless.
KDF_PEPPER=insecure-dev-pepper

PUBLIC_URL=http://localhost:3161

# Event (deployment) configuration
EVENT_NAME="Hardwood High 1"
EVENT_LOCALE=fi
EVENT_TIMEZONE=Europe/Helsinki
# Signed-out visitors of the front page are redirected here.
LARPIT_URL=https://larpit.fi/larp/01a11819-1e04-7408-83a7-1e578c9622ea

# The GM public key printed by `npm run init`. Optional in development (the Event row is
# trusted); production refuses to seal data to the GMs without it.
# GM_PUBLIC_KEY=
